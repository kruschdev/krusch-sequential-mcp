# PostgreSQL connection string for DBOS thought persistence.
# If not set, the server runs without persistence (in-memory only).
DATABASE_URL=postgres://user:password@localhost:5432/mydb

# Ollama API base URL for the Semantic Plausibility Gate.
# Only used when agents supply a groundingContext parameter.
OLLAMA_URL=http://localhost:11434

# Model used for plausibility screening. Should be a small, fast model.
PLAUSIBILITY_MODEL=qwen2.5-coder:1.5b
